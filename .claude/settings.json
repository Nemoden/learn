{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(~/.aws/**)"
    ],
    "allow": [
      "Bash(aws acm list-certificates*)",
      "Bash(aws apigateway get*)",
      "Bash(aws apigatewayv2 get-domain-names*)",
      "Bash(aws appconfig get-hosted-configuration-version*)",
      "Bash(aws appconfig list-applications*)",
      "Bash(aws appconfig list-configuration-profiles*)",
      "Bash(aws appconfig list-environments*)",
      "Bash(aws cloudformation describe*)",
      "Bash(aws cloudformation list*)",
      "Bash(aws cloudfront list-distributions*)",
      "Bash(aws cognito-idp describe*)",
      "Bash(aws cognito-idp list*)",
      "Bash(aws dynamodb describe*)",
      "Bash(aws dynamodb get-item*)",
      "Bash(aws dynamodb list-tables*)",
      "Bash(aws dynamodb query*)",
      "Bash(aws dynamodb scan*)",
      "Bash(aws events describe*)",
      "Bash(aws events list*)",
      "Bash(aws lambda get*)",
      "Bash(aws lambda list*)",
      "Bash(aws logs*)",
      "Bash(aws s3 ls*)",
      "Bash(aws s3api list-buckets*)",
      "Bash(aws sns get*)",
      "Bash(aws sns list*)",
      "Bash(aws sqs get*)",
      "Bash(aws sqs list*)",
      "Bash(aws ssm get-parameter*)",
      "Bash(aws sts get-caller-identity*)",
      "Bash(curl *)",
      "Bash(gh pr diff*)",
      "Bash(gh pr view*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(git branch*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git status*)",
      "Bash(head *)",
      "Bash(jira epic list*)",
      "Bash(jira issue list*)",
      "Bash(jira issue view*)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(npm list*)",
      "Bash(pip list*)",
      "Bash(pip show*)",
      "Bash(pwd)",
      "Bash(pytest*)",
      "Bash(python -c *)",
      "Bash(python -m pytest*)",
      "Bash(serverless info*)",
      "Bash(serverless print*)",
      "Bash(tail *)",
      "Bash(which *)"
    ]
  },
  "outputStyle": "Learning"
}

# DevCollab Platform - Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env to git!

# ═══════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════

DATABASE_URL=postgresql://devuser:devpass123@localhost:5432/devcollab
REDIS_URL=redis://:redispass123@localhost:6379/0

# ═══════════════════════════════════════════════════════════
# JWT Configuration (Sprint 1)
# ═══════════════════════════════════════════════════════════

JWT_SECRET=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ═══════════════════════════════════════════════════════════
# OAuth Server Configuration (Sprint 2)
# ═══════════════════════════════════════════════════════════

OAUTH_ISSUER=http://localhost:4000
OAUTH_CLIENT_ID=devcollab-web
OAUTH_REDIRECT_URI=http://localhost:3000/callback

# For RS256 (asymmetric signing):
# JWT_PRIVATE_KEY_PATH=./keys/private.pem
# JWT_PUBLIC_KEY_PATH=./keys/public.pem

# ═══════════════════════════════════════════════════════════
# MFA Configuration (Sprint 3)
# ═══════════════════════════════════════════════════════════

# Encryption key for TOTP secrets (must be 32 bytes, base64 encoded)
TOTP_ENCRYPTION_KEY=change-this-to-a-random-32-byte-key-base64-encoded

# WebAuthn configuration
WEBAUTHN_RP_NAME=DevCollab
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ═══════════════════════════════════════════════════════════
# External IdP Integration (Sprint 4)
# ═══════════════════════════════════════════════════════════

# Keycloak (for SAML testing)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=devcollab
KEYCLOAK_CLIENT_ID=devcollab-sp

# GitHub OAuth (for social login)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Google OAuth (for social login)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ═══════════════════════════════════════════════════════════
# Application Configuration
# ═══════════════════════════════════════════════════════════

NODE_ENV=development
LOG_LEVEL=debug

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ═══════════════════════════════════════════════════════════
# Observability (Sprint 4)
# ═══════════════════════════════════════════════════════════

PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ═══════════════════════════════════════════════════════════
# Security
# ═══════════════════════════════════════════════════════════

# Session configuration
SESSION_SECRET=change-this-to-a-random-session-secret
SESSION_MAX_AGE_SECONDS=86400

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=5    # Max login attempts per window

# Account lockout
LOCKOUT_DURATION_MINUTES=30
MAX_FAILED_ATTEMPTS=5

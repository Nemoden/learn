{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSecurityAcctToAssume",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::SECURITY_ACCT_ID:role/CrossReadRole"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "CHANGE_ME_TO_A_SECRET"
        }
      }
    }
  ]
}
